          }
        },
        {
          "tool": "apply_approved_source_change",
          "input": {
            "edit_id": "$LAST_EDIT_ID"
          }
        },
        {
          "tool": "apply_approved_source_change",
          "input": {
            "edit_id": "$LAST_EDIT_ID"
          }
        }
      ],
      "expect": "last_call_refused"
    }
  ],
  "control": {
    "id": "approved-edit-is-written",
    "human": "approve",
    "steps": [
