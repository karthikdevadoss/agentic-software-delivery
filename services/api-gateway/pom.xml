<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>api-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>api-gateway</name>
    <description>Single public entry point for the microservices decomposition -- see docs/MICROSERVICES_ARCHITECTURE.md. Routing only, no business logic.</description>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Server MVC variant, not the reactive/WebFlux gateway: this
             whole decomposition otherwise uses the standard Spring MVC
             (servlet) stack throughout (see app's own pom.xml), and
             mixing in a reactive gateway would mean the ONE place in
             the whole system using a genuinely different concurrency
             model, for no real benefit at this traffic scale. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- BL-014: the gateway is where every real request enters the
             system, so it must be the one that actually starts a trace.
             This was entirely missing before (billing/customer/metering/
             notification-service all already had it; the gateway alone
             did not), a real gap found sizing this task LARGE/LOW
             confidence per its first-of-its-kind-integration heuristic. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <!-- BL-014 real finding: micrometer-tracing-bridge-brave alone
             gives Brave classes on the classpath but not the Spring Boot
             autoconfiguration glue that creates an active Tracer bean
             wired into the Observation pipeline. In Boot 4's modular
             split that glue is this separate module. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ACT-014 / BL-024: real downstream stubs for
             GatewayRoutingIntegrationTest, proving GatewayRoutesConfig's
             route selection and the lb()+uri() forwarding filter chain
             actually deliver a request to the right downstream, and (per
             docs/TESTING_ARCHITECTURE_V1.md's section S outbound-request-assertion
             convention) that headers are forwarded untouched. Same version
             already proven working elsewhere in this repo
             (services/billing-service/pom.xml, app/pom.xml). -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
