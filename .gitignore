# Environment
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/
.pytest_cache/

# RAG index (derived/build data, regenerate with: python agent/rag_index.py)
agent/.rag_index/

# Curated backend RAG index (derived/build data, regenerate with: python agent/backend_rag_index.py)
agent/.backend_rag_index/

# Local Control UI run-history telemetry (derived/local, not source)
agent/web_run_history.jsonl

# Triage candidate compile/test full output logs (derived/local, not source --
# see agent/triage_execution.py's _persist_full_output; a real incident
# showed a truncated 2000-char tail alone can hide the actual error line)
agent/.triage_logs/

# Local development-session start/stop records (derived/local, not source)
agent/dev_sessions.json

# Event ledger local outage spool (fallback only, not canonical — see agent/event_ledger.py)
agent/event_spool.jsonl
agent/event_spool_test*.jsonl

# Per-test throwaway spool files from test_claude_code_hook.py's
# SpoolIsolatedTestCase (uuid-named, normally deleted in tearDown() — this
# covers the rare case a run is killed before teardown runs, e.g. a
# memory-pressure-killed full suite; see docs/LESSONS.md)
agent/claude_hook_test_spool_*.jsonl

# Event ledger portable logical backups (derived data, on-demand only — see agent/event_ledger_backup.py)
agent/event_ledger_backups/

# Event ledger background-sync lock (transient, released as soon as a sync finishes)
agent/event_ledger_sync.lock

# Selective regression engine evidence (derived/local per-run record — see agent/verify_change.py)
agent/.verify_change_evidence/

# Java / Maven
target/
*.class
*.jar
*.war

# Real-topology test harness per-run service logs (derived/local, not source — see services/real-topology-tests/)
services/real-topology-tests/logs/

# Node / Playwright (e2e/, Phase 2 browser regression suite)
node_modules/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
