<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>customer-app</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>customer-app</name>
    <description>Minimal Customer Spring Boot application</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- GraphQL: exposes the same Customer/ContractPlan domain already
             served over REST (CustomerController/ContractPlanController),
             deliberately reusing the exact same services and
             WorkspaceAccessGuard: a genuine, real "REST vs GraphQL over
             the same domain" comparison, not a separate demo app. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- THE ACTUAL ROOT CAUSE of a real CI failure (@KafkaListener never
             fired at all, silently): the same class of bug this project
             already hit with Flyway (see docs/LESSONS.md): Spring Boot 4
             split KafkaAutoConfiguration out into its own module,
             spring-boot-kafka, exactly like spring-boot-flyway/
             spring-boot-jackson. org.springframework.kafka:spring-kafka
             alone is the Kafka LIBRARY (confirmed via `mvn dependency:tree`:
             no spring-boot-kafka anywhere on the classpath), not Spring
             Boot's autoconfiguration/@EnableKafka-equivalent glue that
             actually registers @KafkaListener methods as real listeners:
             without it, KafkaTemplate still worked (this project defines
             its own explicit ProducerFactory/KafkaTemplate beans, needing
             no autoconfiguration), but every @KafkaListener method was
             silently never registered at all. spring-boot-starter-kafka is
             the correct, Boot-blessed way to depend on Kafka support. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- In-process tracing only (no external collector/backend
             configured or required): gives every log line a real
             traceId/spanId via MDC for correlation, satisfying "structured
             logs, correlation IDs" without provisioning a paid
             observability platform. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <!-- Resource-server JWT validation (NimbusJwtDecoder): also
             brings com.nimbusds:nimbus-jose-jwt transitively, which the
             portfolio demo token issuer (see security/DemoJwtIssuer.java)
             reuses to SIGN tokens too, so no separate JWT library is
             needed for issuance. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Postgres profile (see application-postgres.properties): default
             runtime profile remains H2, unchanged, so current production
             behavior is not touched by adding this. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!-- THE ACTUAL ROOT CAUSE of three consecutive real CI failures
             (see docs/LESSONS.md): Spring Boot 4 split FlywayAutoConfiguration
             out of the spring-boot-autoconfigure monolith into its own
             module, spring-boot-flyway, exactly like spring-boot-hibernate/
             spring-boot-jdbc/spring-boot-jpa (confirmed present via `mvn
             dependency:tree`) already are for their own concerns. flyway-core
             + flyway-database-postgresql alone are the Flyway LIBRARY, not
             Spring's autoconfiguration for it; without this module, no
             property (spring.flyway.enabled or otherwise) could ever have
             mattered, because the @Configuration class that even looks at
             that property was never on the classpath in the first place. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.1</version>
        </dependency>

        <!-- Resilience4j CORE modules only (circuitbreaker/retry), not the
             resilience4j-spring-boot3/4 annotation-based starter: as of
             this session, Spring Boot 4 support for that starter has real,
             documented ecosystem immaturity (a resilience4j-spring-boot4
             module missing from its own BOM, see docs/DECISIONS.md).
             The core modules have zero Spring dependency at all, so they
             carry none of that risk; composed programmatically instead of
             via annotations (see ResilienceConfig/AppointmentAvailabilityService). -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>2.4.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>2.4.0</version>
        </dependency>
        <!-- Binds the programmatically-composed CircuitBreaker/Retry
             instances above to Micrometer so their real state (calls,
             failure rate, transitions, retry attempts) shows up in
             /actuator/prometheus alongside HTTP/Hikari metrics: the
             "downstream/retry/circuit metrics" observability requirement. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
            <version>2.4.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.10.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The modern (2.x) module is testcontainers-kafka, matching the
             testcontainers-postgresql naming already used above: the
             legacy artifactId "kafka" was never released past 1.21.x and
             would pull an incompatible testcontainers-core transitively.
             Not covered by Spring Boot's managed Testcontainers BOM
             entries (only postgresql/junit-jupiter are), so pinned
             explicitly to the same 2.0.5 version those resolved to. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <version>2.0.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Real branch/line coverage, not a claimed number: prepare-agent
                 instruments the JVM running `mvn test`, report generates
                 target/site/jacoco/index.html from the real run, and
                 check enforces a floor so coverage can regress loudly in CI
                 instead of silently drifting down over time. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <!-- Set from this project's own real,
                                             freshly-measured coverage (see the
                                             PR that added this plugin) rather
                                             than an arbitrary round number:
                                             a floor just above the real
                                             current value catches genuine
                                             regressions without demanding an
                                             immediate rewrite to hit an
                                             invented target. -->
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Real measured line coverage at the time this
                                                 plugin was added was 0.8471 (648/765 lines,
                                                 target/site/jacoco/jacoco.csv); 0.80 leaves
                                                 real margin for normal fluctuation while still
                                                 catching a genuine regression. -->
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
